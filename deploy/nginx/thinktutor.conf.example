server {
    listen 80;
    listen [::]:80;
    server_name thinktutor.example.com;
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name thinktutor.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/thinktutor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/thinktutor.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Default budget: 45s x (3 coach/review calls + 1 Feynman call) x 3 attempts.
        # Recalculate this if DEEPSEEK_TIMEOUT_MS or AI_MAX_RETRIES changes.
        proxy_read_timeout 600s;
        proxy_send_timeout 75s;
    }
}
