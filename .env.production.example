NODE_ENV=production
DEPLOYMENT_ENV=production
APP_URL=https://thinktutor.example.com
DATABASE_URL=postgresql://app_user:REPLACE@private-rds-host:5432/thinktutor?sslmode=require
AUTH_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
# Not used with OSS; reserve a separate value if local storage is ever enabled outside production.
STORAGE_SIGNING_SECRET=
AUTH_COOKIE_SECURE=true

AI_PROVIDER=deepseek
AI_PSEUDONYM_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_SECRET
DEEPSEEK_API_KEY=REPLACE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

REDIS_URL=redis://:REPLACE@private-tair-host:6379/0
STORAGE_PROVIDER=oss
OSS_REGION=cn-hangzhou
OSS_BUCKET=REPLACE_PRIVATE_BUCKET
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# Preferred: attach a least-privilege RAM Role to ECS and leave all credentials below empty.
# Cross-account AssumeRole only: set OSS_ROLE_ARN together with least-privilege source keys.
OSS_ROLE_ARN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=

MAX_UPLOAD_MB=20
MAX_REFERENCE_TEXT_LENGTH=12000
MAX_USER_MESSAGE_LENGTH=4000
MAX_MESSAGES_PER_SESSION=80
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_AI_PER_DAY=120
ADMIN_INITIAL_EMAIL=
