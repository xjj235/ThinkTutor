NODE_ENV=development
DEPLOYMENT_ENV=development
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://thinktutor:thinktutor-local-only@127.0.0.1:5432/thinktutor
SHADOW_DATABASE_URL=postgresql://thinktutor:thinktutor-local-only@127.0.0.1:5432/thinktutor_shadow
AUTH_SECRET=replace-with-at-least-32-random-characters
# Dedicated to local signed upload/download URLs. Never reuse AUTH_SECRET.
STORAGE_SIGNING_SECRET=replace-with-a-different-32-character-secret
AUTH_COOKIE_SECURE=false

AI_PROVIDER=mock
AI_PSEUDONYM_SECRET=replace-with-a-dedicated-32-character-secret
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_WEB_SEARCH_FALLBACK=true
DEEPSEEK_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_CONTEXT_MAX_CHARS=24000
AI_RECENT_MESSAGE_LIMIT=16
AI_RETRIEVAL_CHUNK_LIMIT=6

REDIS_URL=redis://127.0.0.1:6379
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.data/uploads
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
# Leave empty when using an ECS instance RAM Role. Cross-account AssumeRole requires source keys above.
OSS_ROLE_ARN=

MAX_UPLOAD_MB=20
MAX_REFERENCE_TEXT_LENGTH=12000
MAX_MESSAGES_PER_SESSION=80
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_AI_PER_DAY=120

# Used only by the development seed. Never seed test users in production.
DEV_SEED_PASSWORD=Local-demo-2026
ADMIN_INITIAL_EMAIL=
ALLOW_DRAFT_KNOWLEDGE=true
