{
  "name": "thinktutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -H 127.0.0.1",
    "preview": "tsx scripts/local-preview.ts",
    "preview:lan": "cross-env PREVIEW_NETWORK=lan tsx scripts/local-preview.ts",
    "preview:check": "playwright test --config playwright.preview.config.ts",
    "build": "cross-env STORAGE_SIGNING_SECRET=build-only-storage-signing-secret-never-use-at-runtime next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/with-test-postgres.ts -- pnpm exec vitest run",
    "test:unit": "tsx scripts/with-test-postgres.ts -- pnpm exec vitest run tests/unit",
    "test:integration": "tsx scripts/with-test-postgres.ts -- pnpm exec vitest run tests/integration",
    "test:deepseek:live": "vitest run --config vitest.live.config.mts",
    "acceptance:production": "tsx scripts/production-acceptance.ts",
    "e2e": "tsx scripts/with-test-postgres.ts -- tsx scripts/run-e2e.ts",
    "test:e2e": "pnpm e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "worker": "tsx src/worker/index.ts",
    "worker:material": "tsx scripts/process-material.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.5",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "ali-oss": "6.23.0",
    "argon2": "0.45.1",
    "bullmq": "6.0.9",
    "dotenv": "17.4.2",
    "ioredis": "6.0.0",
    "katex": "0.18.2",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "proxy-agent": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/ali-oss": "6.23.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.1.2",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
